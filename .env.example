# ============================================================
# RED SIGO - Configuración Unificada
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a un repositorio.
# ============================================================

# ================== ELASTICSEARCH ==================
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWD=CHANGE_ME
INDEX_NAME=spaindb

# ================== SEGURIDAD Y TOKENS ==================
# Token compartido entre Server (Go) y API (Python)
BACKEND_BEARER_TOKEN=YOUR_BEARER_TOKEN

# ================== GOOGLE GEMINI AI ==================
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ================== DISCORD WEBHOOKS ==================
DISCORD_SEARCH_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_CHAT_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_PROCESS_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ================== PUERTOS (Opcional - valores por defecto) ==================
BACKEND_LISTEN_ADDR=0.0.0.0:8080
# GATEWAY_PORT=5000
# INDEXER_PORT=8081
# TOR_SOCKS_PORT=9050
# TOR_CONTROL_PORT=9051