# ============================================================
# RED SIGO - Configuración Unificada
# ============================================================
# Copia este archivo como .env y rellena los valores reales.
# NUNCA subas el .env real a un repositorio.
# ============================================================

# ================== ELASTICSEARCH ==================
ES_HOST=http://localhost:9200
ES_USER=elastic
ES_PASSWD=CHANGE_ME
INDEX_NAME=spaindb

# ================== GATEWAY (Python/Flask) ==================
GATEWAY_PORT=5000
AUTHORIZED_TOKENS=["YOUR_TOKEN_HERE"]
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ================== BACKEND (Go) ==================
# Estos valores están en backend/config.go como constantes.
# Para hacerlos dinámicos, modifica config.go para leer env vars.
BACKEND_LISTEN_ADDR=0.0.0.0:80
BACKEND_TOR_PROXY=127.0.0.1:9050
BACKEND_URL=http://127.0.0.1:5000
BACKEND_BEARER_TOKEN=YOUR_BEARER_TOKEN

# ================== DISCORD WEBHOOKS ==================
DISCORD_SEARCH_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_CHAT_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN
DISCORD_PROCESS_WEBHOOK=https://discord.com/api/webhooks/YOUR_ID/YOUR_TOKEN

# ================== INDEXER (Go) ==================
INDEXER_PORT=8081
INDEXER_DATA_FOLDER=./data/db

# ================== TOR ==================
TOR_SOCKS_PORT=9050
TOR_CONTROL_PORT=9051
